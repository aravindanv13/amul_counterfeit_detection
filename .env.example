# -------------------------------------------------------
# Legal Metrology Compliance Checker
# Environment Configuration Template
# -------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-secure-secret-key

# Application paths
UPLOAD_FOLDER=uploads
SAMPLES_FOLDER=static/samples
DATASET_PATH=legal_metrology_dataset.csv

# Review demo: exact image matches to local folders, explicitly labelled in reports.
# Set DEMO_FOLDER_SCORING=0 for unmodified engine scoring.
DEMO_FOLDER_SCORING=1
DEMO_IMAGE_FOLDER=ft_project_images

# Upload limit in megabytes
MAX_CONTENT_LENGTH_MB=16

# OCR
# Leave empty when Tesseract is available through PATH.
#
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Logging
LOG_LEVEL=INFO
